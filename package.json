{
  "name": "tryharder",
  "version": "0.3.0",
  "description": "A better try/catch for TypeScript",
  "keywords": [
    "abort-signal",
    "error-handling",
    "retry",
    "timeout",
    "try-catch"
  ],
  "homepage": "https://github.com/adelrodriguez/tryharder#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/tryharder/issues"
  },
  "license": "MIT",
  "author": "Adel Rodríguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelrodriguez/tryharder.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "analyze": "adamantite analyze",
    "bench": "pnpm run build && node --expose-gc --import tsx bench/index.ts",
    "bench:ci": "pnpm run build && node --expose-gc --import tsx bench/index.ts --json | node --import tsx bench/report.ts",
    "build": "tsdown",
    "build:verify": "pnpm run build && node scripts/verify-package.ts",
    "bump:deps": "pnpm update --interactive",
    "check": "adamantite check",
    "dev": "tsdown --watch",
    "fix": "adamantite fix",
    "format": "adamantite format",
    "release": "changeset publish",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "version": "changeset version && pnpm run format"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@clack/prompts": "1.7.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "adamantite": "0.37.0",
    "fast-check": "4.9.0",
    "knip": "6.32.2",
    "mitata": "^1.0.34",
    "oxfmt": "0.63.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "0.22.14",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.0.0-rc.6"
}
